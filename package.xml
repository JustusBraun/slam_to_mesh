<?xml version="1.0"?>
<package format="3">
  <name>slam_to_mesh</name>
  <version>0.0.1</version>
  <description>A tool to create triangle meshes from the output of point cloud SLAM systems.</description>
  <maintainer email="jubraun@uos.de">Justus Braun</maintainer>
  <license>MIT</license>

  <!-- Dependencies -->
  <buildtool_depend>cmake</buildtool_depend>

  <depend>lvr2</depend>
  <depend>eigen</depend>

  <!-- Optional ROS2 dependencies for bag reading support -->
  <depend>rosbag2_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>

  <export>
    <build_type>cmake</build_type>
  </export>

</package>
